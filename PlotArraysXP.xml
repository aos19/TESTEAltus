  <types>
    <dataTypes />
    <pous>
      <pou name="Comportamento3" pouType="program">
        <interface>
          <localVars>
            <variable name="contadorTempo">
              <type>
                <INT />
              </type>
              <initialValue>
                <simpleValue value="0" />
              </initialValue>
            </variable>
            <variable name="etapaExibicao">
              <type>
                <INT />
              </type>
              <initialValue>
                <simpleValue value="0" />
              </initialValue>
            </variable>
            <variable name="i">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="faseMovimento">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="0.0" />
              </initialValue>
            </variable>
            <variable name="tipoCurva">
              <type>
                <INT />
              </type>
              <initialValue>
                <simpleValue value="0" />
              </initialValue>
            </variable>
            <variable name="amplitudeOnda">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="10.0" />
              </initialValue>
            </variable>
            <variable name="inclinacaoRampa">
              <type>
                <REAL />
              </type>
              <initialValue>
                <simpleValue value="1.5" />
              </initialValue>
            </variable>
            <variable name="VARIAVELNOVATESTANDODIFF2">
              <type>
                <REAL />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">VARIAVELNOVATESTANDODIFF2 := 0;

// Incrmentando o contador
contadorTempo := contadorTempo + 1;
contadorTempo := contadorTempo + 1;
contadorTempo := contadorTempo + 1;
contadorTempo := contadorTempo + 1;
contadorTempo := contadorTempo + 1;

CASE etapaExibicao OF
	// Estado de limpeza da tela
	0: 
		IF contadorTempo &gt;= 100 THEN
			contadorTempo := 0;
			
			// Alternando a curva
			tipoCurva := (tipoCurva + 1) MOD 3;
			
			IF tipoCurva = 0 THEN
				// Estilo 1
				amplitudeOnda := 8.0;
				inclinacaoRampa := 1.0;
				faseMovimento := 0.0;
			
			ELSIF tipoCurva = 1 THEN
				// Estilo 2
				amplitudeOnda := 20.0;
				inclinacaoRampa := 1.5;
				faseMovimento := 2.5;
				
			ELSE
				// Estilo 3
				amplitudeOnda := 5.0;
				inclinacaoRampa := 2.0;
				faseMovimento := 5.0;
			END_IF
			
			// Preenchimento de uma vez
			FOR i := 0 TO 99 DO
				PlotArrays.arraySetpoint[i] := INT_TO_REAL(i) * inclinacaoRampa;
                PlotArrays.arrayCurrentValue[i] := PlotArrays.arraySetpoint[i] + (SIN(INT_TO_REAL(i) * 0.25 + faseMovimento) * amplitudeOnda);
			END_FOR
			
			etapaExibicao := 1;
		END_IF
	
		
	// Estado com a curva visível na tela
	1:
		IF contadorTempo &gt;= 150 THEN
			contadorTempo := 0;
			
			// Zerando o array inteiro
			FOR i := 0 TO 99 DO
				PlotArrays.arraySetpoint[i] := 0.0;
				PLotArrays.arrayCurrentValue[i] := 0.0; 
			END_FOR
			
			// Estado de tela limpa
			etapaExibicao := 0;			
	END_IF
END_CASE</xhtml>
          </ST>
        </body>
